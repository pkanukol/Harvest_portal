# Project B (ukpythuclqvjwygqrsds) - ONE project, one client.
#
# It holds both halves of this app's data now: the timetable domain tables
# (see project_b_schema.sql) and staff_roles, which is the only teacher
# identity. The old split between a Project A client and a read-only Project B
# client is gone, and so are VITE_STAFF_SUPABASE_URL / _ANON_KEY.
VITE_TIMETABLE_SUPABASE_URL=
VITE_TIMETABLE_SUPABASE_ANON_KEY=

# No VITE_PORTAL_URL any more: the portal's ?sso=<access_token> handoff was
# removed. That token is signed with Project A's JWT secret and Project B's
# PostgREST will not verify it, so the app signs in against Project B's own
# Supabase Auth with email+password instead (same as Attendance).
# Create accounts in the Supabase dashboard: Authentication -> Users.
